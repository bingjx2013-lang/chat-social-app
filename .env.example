# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
DATA_DIR=./data

# Optional Coturn REST API credentials for reliable public-network calls.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SHARED_SECRET=replace-with-your-private-coturn-shared-secret

# Optional email verification. Keep false unless SMTP is fully configured.
REQUIRE_EMAIL_VERIFICATION=false
# PUBLIC_BASE_URL=https://your-real-domain.example
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# EMAIL_FROM=Microchat <no-reply@example.com>

# Optional backup location; default is DATA_DIR/backups.
# BACKUP_DIR=./backups
